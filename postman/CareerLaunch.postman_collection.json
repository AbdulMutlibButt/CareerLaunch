{
  "info": {
    "name": "CareerLaunch",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Session cookies are stored by Postman. Use demo credentials only with local demo mode or a seeded development MongoDB. Log in as the role required by each endpoint."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:4000/api"
    },
    {
      "key": "jobId",
      "value": ""
    },
    {
      "key": "applicationId",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Register applicant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Applicant\",\n  \"email\": \"new@example.com\",\n  \"password\": \"{{password}}\",\n  \"role\": \"applicant\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login employer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"employer@careerlaunch.demo\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login applicant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"applicant@careerlaunch.demo\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Profiles",
      "item": [
        {
          "name": "My profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/profile"
          }
        },
        {
          "name": "Update company",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"My Company\",\n  \"description\": \"We build useful products.\",\n  \"location\": \"Lahore\",\n  \"website\": \"https://example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update applicant",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bio\": \"A developer interested in React.\",\n  \"skills\": [\n    \"React\",\n    \"Node.js\"\n  ],\n  \"education\": \"BS Computer Science\",\n  \"experience\": \"Personal projects\",\n  \"resumeUrl\": \"https://example.com/resume.pdf\",\n  \"location\": \"Lahore\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Search jobs",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/jobs?q=React&workplaceType=Remote&page=1"
          }
        },
        {
          "name": "Job detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/jobs/{{jobId}}"
          }
        },
        {
          "name": "Create job as employer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/jobs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Frontend Developer Intern\",\n  \"description\": \"Build accessible React interfaces and collaborate with an experienced product team.\",\n  \"location\": \"Lahore\",\n  \"jobType\": \"Internship\",\n  \"workplaceType\": \"Remote\",\n  \"skills\": [\n    \"React\",\n    \"Tailwind\"\n  ],\n  \"salary\": \"PKR 40,000 / month\",\n  \"applicationDeadline\": \"2099-12-31\",\n  \"status\": \"Open\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Request succeeds\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "if (pm.response.code < 300) pm.collectionVariables.set(\"jobId\", pm.response.json()._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Close job",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/jobs/{{jobId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Closed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Reopen job",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/jobs/{{jobId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Open\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete job",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/jobs/{{jobId}}"
          }
        }
      ]
    },
    {
      "name": "Applicant workflow",
      "item": [
        {
          "name": "Save job",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/jobs/{{jobId}}/save"
          }
        },
        {
          "name": "Saved jobs",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/saved-jobs"
          }
        },
        {
          "name": "Unsave job",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/jobs/{{jobId}}/save"
          }
        },
        {
          "name": "Apply",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/jobs/{{jobId}}/apply",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"coverLetter\": \"I enjoy building thoughtful React applications and would love to contribute to your team.\",\n  \"resumeUrl\": \"https://example.com/resume.pdf\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Request succeeds\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "if (pm.response.code < 300) pm.collectionVariables.set(\"applicationId\", pm.response.json()._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "My applications",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/applications/me"
          }
        },
        {
          "name": "Withdraw pending application",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/applications/{{applicationId}}/withdraw"
          }
        }
      ]
    },
    {
      "name": "Employer workflow",
      "item": [
        {
          "name": "My jobs",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/employer/jobs"
          }
        },
        {
          "name": "View applicants",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/employer/jobs/{{jobId}}/applications"
          }
        },
        {
          "name": "Start review",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/applications/{{applicationId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Reviewing\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Accept application",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/applications/{{applicationId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Accepted\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Reject application",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/applications/{{applicationId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Rejected\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
