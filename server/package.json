{
  "name": "careerlaunch-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "node --check src/index.js && node --check src/create-app.js && node --check src/config.js && node --check src/listener.js && node --check src/store.js",
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test test/*.test.js",
    "seed": "node src/seed.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongoose": "^8.19.0",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.1.0",
    "zod": "^4.1.0",
    "dotenv": "^17.2.0"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
