{
  "name": "careerlaunch",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "test": "npm run test -w server",
    "seed": "npm run seed -w server"
  },
  "overrides": {
    "postcss": "^8.5.28"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
